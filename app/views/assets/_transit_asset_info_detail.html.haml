%hr
- if asset.fta_asset_category.name == 'Facilities'
  = format_field("TERM Threshold", asset.useful_life_benchmark)
- elsif asset.fta_asset_category != 'Infrastructure'
  = format_field("NTD Useful Life Benchmark", asset.try(:useful_life_benchmark))
  = format_field("NTD Useful Life Remaining", asset.try(:useful_life_remaining), 'Calculated by current year minus Year of Manufacture')
= format_field("Appraised Value", format_as_currency(asset.try(:current_appraisal_value)))