- frm = Form.find_by(controller: 'ntd_forms')

%li.text-left.dropdown-submenu{tabindex: 0}
  = link_to '#', tabindex: -1 do
    %i.fa.fa-file-text-o.fa-fw
    = frm.name
  %ul.dropdown-menu
    %li.text-left
      = link_to asset_fleets_path  do
        %i.fa.fa-file-text-o.fa-fw
        Fleets
    %li.text-left
      = link_to form_path(frm)  do
        %i.fa.fa-file-text-o.fa-fw
        Asset Reports